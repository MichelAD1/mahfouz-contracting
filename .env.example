# Copy to .env.local and fill in.
#
# The site renders fully from src/sanity/fallback/content.ts with none of these
# set, so it runs before the CMS exists. Fill them in to switch to Sanity and
# unlock /studio.

# From sanity.io/manage after creating the project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://mahfouzcontracting.com

# Where the enquiry form delivers. Falls back to this when the Sanity contact
# document has no recipientEmail set. Server-side only, never sent to the browser.
CONTACT_RECIPIENT_EMAIL=
